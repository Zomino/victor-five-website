{
  "name": "Victor Five",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:dev-24-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "runArgs": ["--name", "victor-five-dev"],
  "forwardPorts": [3000]
}
